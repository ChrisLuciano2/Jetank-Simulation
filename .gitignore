# Unity generated files (match at any depth)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
.vs/
.vsconfig

# Scratch telemetry from live drives. Recordings kept as regression
# fixtures live in Python/test_data/ and are NOT matched by this.
/Python/*.csv

# Diagnostic dumps from validate_camera.py --save
/Python/validate_*.png
*.swp
*.swo

# Ad-hoc diag_*.py run output/logs and nav telemetry dirs (the diag_*.py
# SCRIPTS themselves are real tooling and are tracked -- only their
# throwaway per-run output isn't).
/Python/diag_*_output*.log
/Python/diag_*test*.log
/Python/diag_creep_debug*.log
/Python/nav_logs_*/
/Python/robot_a.log
/Python/robot_b.log

# Unity auto-recovery scratch scenes -- not real project content.
/Robots/Assets/_Recovery/
/Robots/Assets/_Recovery.meta

# Scratch logs/screenshots from launching Unity via automation.
/unity_open*.log
/unity_relaunch.log
/unity_dialog_screenshot.png
